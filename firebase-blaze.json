{
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "sbooky",
      "runtime": "nodejs22",
      "predeploy": [
        "node firebase/sync-core.cjs"
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/blaze-firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firebase/**",
      "tests/**",
      "*.md",
      "*.txt",
      "*.zip",
      "package*.json",
      "**/*.log",
      "firebase-blaze.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
